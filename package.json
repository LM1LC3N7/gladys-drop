{
  "name": "gladys-drop",
  "version": "0.1.1",
  "private": true,
  "description": "Gladys Assistant external integration for DROP water management (Chandler Systems) over local MQTT: hub, shutoff valve, leak detectors, softener, filter, flow and use; opening and closing the water off by default. Unofficial, not affiliated with Chandler Systems.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png",
    "mutants": "node scripts/mutants.mjs",
    "validate:manifest": "npx --yes github:GladysAssistant/integration-store ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.1",
    "mqtt": "^5.16.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "mqtt-packet": "^9.0.2",
    "prettier": "^3.10.1"
  },
  "license": "Apache-2.0"
}
